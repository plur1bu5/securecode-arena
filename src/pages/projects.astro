---
import Base from "../layouts/Base.astro";
import data from "../data/data.json";
import { cweHref } from "../lib/format";

const { meta, projects } = data;
const names = data.cwe_names as Record<string, string>;

const langs: Record<string, string[]> = {
  "01_auth_api": ["Python", "Go", "JavaScript"],
  "02_file_service": ["Python", "Go", "JavaScript"],
  "03_db_search": ["Python", "Go", "JavaScript"],
  "04_health_monitor": ["Python", "Go", "JavaScript"],
  "05_session_handler": ["Python", "Go", "JavaScript"],
  "06_control": ["Python"],
};
---
<Base title={`Projects · ${meta.title}`} active="projects" description="The six coding tasks and the CWE classes each one is designed to provoke.">
  <article class="article">
    <h1>The six coding tasks</h1>
    <p class="lede">
      Each project is a realistic request. The prompt never mentions security.
      Languages: {meta.languages.join(", ")}. The control is Python only.
    </p>
    <div class="project-grid" style="margin-top:28px">
      {projects.map((p) => (
        <article class="project-card">
          <p class="faint" style="font-size:12px;margin:0 0 6px">{p.id}</p>
          <h3>{p.name.replace(" — ", ": ")}</h3>
          <p class="muted" style="margin:0 0 10px">{p.desc}</p>
          <p class="faint" style="font-size:13px;margin:0">Languages: {langs[p.id].join(", ")}</p>
          <div class="chips">
            {p.targeted_cwes.length === 0 && <span class="chip">No targeted CWE (control)</span>}
            {p.targeted_cwes.map((c) => (
              <a class="chip" href={cweHref(c)} title={names[c] ?? c}>{c}{names[c] ? `: ${names[c]}` : ""}</a>
            ))}
          </div>
          {p.manual_cwes.length > 0 && (
            <div class="chips">
              {p.manual_cwes.map((c) => (
                <a class="chip" href={cweHref(c)} title="Manual-review CWE">{c} (manual)</a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </article>
</Base>
